# Local development settings. Copy to .env (gitignored) and adjust if needed.
# Every value here has a matching default in docker-compose.yml, so .env is optional.

# --- Postgres (docker compose) ---
POSTGRES_USER=stashvent
POSTGRES_PASSWORD=stashvent
POSTGRES_DB=stashvent
POSTGRES_PORT=5438
DATABASE_URL=postgres://stashvent:stashvent@localhost:5438/stashvent?sslmode=disable

# --- S3-compatible object storage (SeaweedFS in local dev) ---
# S3_ENDPOINT: how the server reaches storage. From the host it's localhost; the
# containerized server (compose profile "server") uses http://seaweedfs:8333.
# S3_PUBLIC_ENDPOINT: used to sign presigned URLs, so it must be reachable by the CLI.
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=stashvent
S3_USE_PATH_STYLE=true
# Local-dev credentials only. Must match deploy/docker/seaweedfs-s3.json.
S3_ACCESS_KEY=stashvent-dev
S3_SECRET_KEY=stashvent-dev-secret

# --- Server ---
SERVER_ADDR=:8080
SERVER_PORT=8080
LOG_LEVEL=info
# 5 MB of encrypted payload. Lower it to accept less. It can't go higher: the
# CLI never sends or downloads more, so the server refuses to start above it.
MAX_PAYLOAD_BYTES=5242880
# Rate limits per client address: requests per minute, and how many may come at
# once (burst). CREATE is POST /v1/shares, LOOKUP is GET /v1/shares/{id} and its
# /summary, OTHER is /complete and DELETE. Health endpoints are not limited. Each replica counts
# on its own. These are development values; choose your own for production.
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_CREATE_BURST=5
RATE_LIMIT_LOOKUP_PER_MINUTE=30
RATE_LIMIT_LOOKUP_BURST=10
RATE_LIMIT_OTHER_PER_MINUTE=60
RATE_LIMIT_OTHER_BURST=20
# Creates per API key, on top of the per-address limit; only with REQUIRE_API_KEY.
RATE_LIMIT_KEY_CREATE_PER_MINUTE=10
RATE_LIMIT_KEY_CREATE_BURST=5
# Comma-separated addresses or CIDR ranges of reverse proxies whose
# X-Forwarded-For header is believed, e.g. 10.0.0.0/8,192.168.1.5. Empty: the
# header is ignored and the connection's own address is the client.
TRUSTED_PROXIES=

# --- API keys and abuse controls ---
# true: POST /v1/shares needs "Authorization: Bearer sv_..."; issue keys with
# "stashvent-server keys issue --label <who>". Off by default: fine on a private
# network, but turn it on before exposing a server to the internet.
REQUIRE_API_KEY=false
# Shares one key may create per UTC day (0: no quota). Only with REQUIRE_API_KEY.
API_KEY_SHARES_PER_DAY=10
# Cap on the declared bytes of all unexpired shares, pending ones included
# (0: no cap). Size it to your bucket.
MAX_STORED_BYTES=0
# Lookups (GET /v1/shares/{id}) one share answers before 410 (0: no cap).
MAX_PULLS_PER_SHARE=50

# --- Migrations (goose) ---
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://stashvent:stashvent@localhost:5438/stashvent?sslmode=disable
GOOSE_MIGRATION_DIR=internal/storage/postgres/migrations
